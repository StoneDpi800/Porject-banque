def page_utilisateur(nom, prenom, solde, page: ft.Page):
    page.appbar = None
    page.clean()

    page.vertical_alignment = ft.MainAxisAlignment.START
    page.horizontal_alignment = ft.CrossAxisAlignment.CENTER

    champs_montant = ft.TextField(label="Enter your amount", width=300)
    solde_client = ft.Text(f"Solde : {solde:.2f} €", size=24, weight=ft.FontWeight.BOLD)
    message_utilisateur = ft.Text("")

    def deposer(e):
        nonlocal solde
        try:
            montant = float(champs_montant.value)
        except (ValueError, TypeError):
            message_utilisateur.value = "Enter a number please !"
            message_utilisateur.color = ft.Colors.RED
            page.update()
            return

        if montant <= 0:
            message_utilisateur.value = "Enter a number above 0 !"
            message_utilisateur.color = ft.Colors.RED
            page.update()
            return

        solde += montant
        solde_client.value = f"Solde : {solde:.2f} €"
        add_money(solde, nom, prenom)
        message_utilisateur.value = "deposit valide !"
        message_utilisateur.color = ft.Colors.GREEN
        page.update()

    def retirer(e):
        nonlocal solde
        try:
            montant = float(champs_montant.value)
        except (ValueError, TypeError):
            message_utilisateur.value = "Enter a number please !"
            message_utilisateur.color = ft.Colors.RED
            page.update()
            return

        if montant <= 0:
            message_utilisateur.value = "Enter a number above 0 !"
            message_utilisateur.color = ft.Colors.RED
            page.update()
            return

        if solde < montant:
            message_utilisateur.value = "Montant insuffisent !"
            message_utilisateur.color = ft.Colors.RED
            page.update()
            return

        solde -= montant
        solde_client.value = f"Solde : {solde:.2f} €"
        delete_money(solde, nom, prenom)
        message_utilisateur.value = "withdraw valide !"
        message_utilisateur.color = ft.Colors.GREEN
        page.update()



    page_delete_compte = ft.AlertDialog(
        modal=True,
        title=ft.Text("Delete account"),
        content=ft.Text("Are you sure you want delete account ?"),
        actions_alignment=ft.MainAxisAlignment.END
    )

    page.overlay.append(page_delete_compte)

    def delete_user(e):
        page_delete_compte.open = False
        page.clean()
        page.vertical_alignment = ft.MainAxisAlignment.CENTER
        page.horizontal_alignment = ft.CrossAxisAlignment.CENTER

        delete_comptes(nom, prenom)

        colonne_delete_user = ft.Column(controls=[ft.Image(src="logo_valider_2.avif", width=300, height=300), ft.Text("Delete accounte valide !", color="green"),
                                                  ft.ElevatedButton("Return welcom", width=200, on_click=lambda e:return_page(page),
                                                                    style=ft.ButtonStyle(
                                                                        color=ft.Colors.WHITE,
                                                                        bgcolor=ft.Colors.BLUE_900,
                                                                        overlay_color=ft.Colors.BLUE_700
                                                                    )
                                                                    )
                                                  ],
                                        horizontal_alignment=ft.CrossAxisAlignment.CENTER
                                        )
        page.add(colonne_delete_user)

    def fermer_p_delete_c(e):
        page_delete_compte.open = False
        page.update()
        page_utilisateur(nom, prenom, solde, page)



    button_non = ft.ElevatedButton("No", width=100, on_click=fermer_p_delete_c, style=ft.ButtonStyle(
    color=ft.Colors.WHITE,
    bgcolor=ft.Colors.RED_900,
    overlay_color=ft.Colors.RED_200
)
                                     )
    button_oui = ft.ElevatedButton("Yes", width=100, on_click=delete_user, style=ft.ButtonStyle(
    color=ft.Colors.WHITE,
    bgcolor=ft.Colors.BLUE_900,
    overlay_color=ft.Colors.BLUE_700
)
                                     )

    page_delete_compte.actions = [button_oui, button_non]

    def ouvrir_p_delete_compte(e):
        page.dialog = page_delete_compte
        page_delete_compte.open = True
        page.update()



    button_deposer = ft.ElevatedButton("Deposit", width=200, on_click=deposer, style=ft.ButtonStyle(
        color=ft.Colors.WHITE,
        bgcolor=ft.Colors.BLUE_900,
        overlay_color=ft.Colors.BLUE_700
    )
                                         )
    button_retirer = ft.ElevatedButton("Withdraw", width=200, on_click=retirer, style=ft.ButtonStyle(
        color=ft.Colors.WHITE,
        bgcolor=ft.Colors.BLUE_900,
        overlay_color=ft.Colors.BLUE_700
    )
                                         )

    button_delete_compte = ft.ElevatedButton("Delete account", width=200, on_click=ouvrir_p_delete_compte, style=ft.ButtonStyle(
        color=ft.Colors.WHITE,
        bgcolor=ft.Colors.RED_900,
        overlay_color=ft.Colors.RED_200
    )
                                         )

    page_decon_confirm = ft.AlertDialog(
        modal=True,
        title=ft.Text("Logout confirmation"),
        content=ft.Text("Are you sure you want to log out?"),
        actions_alignment=ft.MainAxisAlignment.END
