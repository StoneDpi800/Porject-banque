    )

    header = ft.Row(controls=[button_deconnexion, button_delete_compte], alignment=ft.MainAxisAlignment.SPACE_BETWEEN)

    contenu_principal = ft.Column(
        controls=[
            ft.Text(f"Hi {prenom} {nom} !", size=30, weight=ft.FontWeight.BOLD),
            champs_montant,
            solde_client,
            button_deposer,
            button_retirer,
            message_utilisateur
        ],
        horizontal_alignment=ft.CrossAxisAlignment.CENTER,
        alignment=ft.MainAxisAlignment.CENTER,
        expand=True)

    page.add(header, contenu_principal)


def traitement_connexion(nom, prenom, code, message, page: ft.Page):
    nom_v = nom.value.strip()
    prenom_v = prenom.value.strip()
    code_v = code.value.strip()

    if nom_v.isalpha() == False:
        message.value = "Your nom or prenom is incorrect !"
        page.update()
        return

    if prenom_v.isalpha() == False:
        message.value = "Your nom or prenom is incorrect !"
        page.update()
        return

    verifi_code_connect = verification(code_v, pattern_code)

    if verifi_code_connect == False:
        message.value = "Your code is incorrect !"
        page.update()
        return

    curseur.execute("SELECT id, nom, prenom, age, solde, code FROM comptes WHERE nom=%s AND prenom=%s AND code=%s", (nom_v, prenom_v, code_v))
    info_client = curseur.fetchone()

    if info_client == None:
        message.value = "Your information is not in the database !"
        page.update()
        return

    page_utilisateur(nom_v, prenom_v, float(info_client[4]), page)



def traitement_inscription(nom, prenom, age, message, page: ft.Page):
    nom_v = nom.value.strip()
    prenom_v = prenom.value.strip()
    age_v = age.value.strip()

    if nom_v.isalpha() == False:
        message.value = "Your nom or prenom is incorrect !"
        page.update()
        return

    if prenom_v.isalpha() == False:
        message.value = "Your nom or prenom is incorrect !"
        page.update()
        return

    if age_v.isdigit() == False or int(age_v) < 15:
        message.value = "Your age is incorrect (+15y)"
        page.update()
        return


    page.clean()

    page.vertical_alignment = ft.MainAxisAlignment.CENTER
    page.horizontal_alignment = ft.CrossAxisAlignment.CENTER

    code_input_i = ft.TextField(label="Enter your code", width=400, password=True, can_reveal_password=True)
    message_code = ft.Text("", color="red")


    button_valider = ft.ElevatedButton("Valider code", width=200, on_click=lambda e: page_utilisateur(nom_v, prenom_v, 0, page), style=ft.ButtonStyle(
        color=ft.Colors.WHITE,
        bgcolor=ft.Colors.BLUE_900,
        overlay_color=ft.Colors.BLUE_700
    )
                                         )
    button_back = ft.IconButton(
        icon=ft.Icons.LOGOUT,
        tooltip="Back to welcom page",
        on_click=lambda e: return_page(page)
    )
    page.appbar = ft.AppBar(leading=button_back)

    def button_code(e):
        nonlocal message_code
        code_v = code_input_i.value
        verifie_code = verification(code_v, pattern_code)

        if verifie_code == True:
            add_comptes(nom_v, prenom_v, int(age_v), 0, code_v)
            page.appbar = None
            page.clean()
            logo_valider_i = ft.Image(src="logo_valider_2.avif", width=300, height=300)
            page.add(logo_valider_i, ft.Text("Account creation complete", color="green"), button_valider)
        else:
            message_code.value = "Your code is incorrect !"
            page.update()

    button_code_result = ft.ElevatedButton("Valider code", width=200, on_click=button_code, style=ft.ButtonStyle(
        color=ft.Colors.WHITE,
        bgcolor=ft.Colors.BLUE_900,
        overlay_color=ft.Colors.BLUE_700
    )
                                         )

    page.add(ft.Text(f"Welcome {nom_v} {prenom_v} in your bank."), code_input_i, message_code, button_code_result)





